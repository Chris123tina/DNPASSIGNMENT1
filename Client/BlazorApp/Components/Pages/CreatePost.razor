@page "/create-post"

@using ApiContracts
@using Blazor.Components.Services

@inject IPostService PostService
@inject NavigationManager Navigation

<h3>Create New Post</h3>

<div class="mb-3">
    <label class="form-label">Title</label>
    <input class="form-control"
           @bind="_title" />
</div>

<div class="mb-3">
    <label class="form-label">Body</label>
    <textarea class="form-control"
              rows="5"
              @bind="_body">
    </textarea>
</div>

<button class="btn btn-primary"
        @onclick="CreatePostAsync">
    Create Post
</button>

<p class="mt-3">@_message</p>

@code {
    private string _title = "";
    private string _body = "";
    private string _message = "";

    private async Task CreatePostAsync()
    {
        if (string.IsNullOrWhiteSpace(_title)
            || string.IsNullOrWhiteSpace(_body))
        {
            _message = "Title and body are required.";
            return;
        }

        try
        {
            CreatePostDto request = new CreatePostDto
            {
                Title = _title,
                Body = _body,
                UserId = 1
            };

            PostDto createdPost =
                await PostService.CreatePostAsync(request);

            Navigation.NavigateTo($"/posts/{createdPost.Id}");
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
        }
    }
}